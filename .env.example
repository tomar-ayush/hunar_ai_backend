# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/hunar_db

# === JWT Auth ===
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Celery / Redis ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === Apollo.IO People Search API ===
# Sign up at https://app.apollo.io → Settings → API Keys
APOLLO_API_KEY=your-apollo-api-key-here

# === Hunar.AI Voice API ===
# Sign up at https://hunar.ai → Dashboard → API
HUNAR_API_KEY=your-hunar-api-key-here
HUNAR_WEBHOOK_SECRET=your-webhook-signing-secret

# === Google Gemini LLM ===
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
