# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/hunar_db

# === Celery / Redis ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === Apollo.IO People Search API ===
# Sign up at https://app.apollo.io → Settings → API Keys
APOLLO_API_KEY=your-apollo-api-key-here

# === Hunar.AI Voice API ===
# Docs: https://api.voice.hunar.ai/docs/external/
# Only your API key is needed. Hunar signs webhooks with your API key (no separate webhook secret required).
HUNAR_API_KEY=your-hunar-api-key-here
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1
# Optional: Set a default agent ID (or the system will select your first active agent via GET /agents/)
HUNAR_AGENT_ID=
# Optional: Public HTTPS URL for webhooks (e.g. https://xyz.ngrok-free.app or your deployed backend URL)
HUNAR_CALLBACK_BASE_URL=

# === Google Gemini LLM ===
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
