# === Application Environment ===
# development, staging, production (in production, Swagger / OpenAPI docs are disabled)
ENVIRONMENT=development

# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/hunar_db

# === Apollo.IO People Search API ===
# Sign up at https://app.apollo.io → Settings → API Keys
APOLLO_API_KEY=your-apollo-api-key-here

# === Hunar.AI Voice API ===
# Docs: https://api.voice.hunar.ai/docs/external/
# Only your API key is needed. Hunar signs webhooks with your API key (no separate webhook secret required).
HUNAR_API_KEY=your-hunar-api-key-here
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1

# === Google Gemini LLM ===
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
